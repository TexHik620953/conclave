# Copy to .env and export before running conclave.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Optional: override the CLI session database location.
# CONCLAVE_DB=$HOME/.local/share/conclave/conclave.db

# Optional: model stream timeouts. Increase for slow providers or large contexts.
# CONCLAVE_LLM_FIRST_TOKEN_TIMEOUT=180s
# CONCLAVE_LLM_IDLE_TIMEOUT=180s
