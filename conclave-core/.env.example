# Copy to .env and fill the key: `cp .env.example .env`.
#
# These values SEED the database the first time it is empty. Afterwards the DB is
# the source of truth and is hot-reloaded by every replica (no restart). Provider
# API keys are stored as plain text in the DB.
#
# Manage providers/models/roles/grades/brains over the admin API:
#   X-Admin-Key: <CORE_SECRET_KEY>
#   POST /v1/admin/providers, POST /v1/admin/providers/{id}/models,
#   POST /v1/admin/roles, POST /v1/admin/roles/{id}/grades,
#   PUT  /v1/admin/brain-configs/{name}
# Read them with GET /v1/roles.

CORE_SECRET_KEY=change-me
CORE_CONFIG_POLL=15s

# --- Bootstrap providers (seed only) ---
CORE_PROVIDERS={"deepseek":{"base_url":"https://api.deepseek.com/v1","api_key":"sk-REPLACE_ME"},"ollama":{"base_url":"http://host.docker.internal:11434/v1","models":["qwen2.5-coder:7b"]}}
CORE_DEFAULT_PROVIDER=deepseek
CORE_LLM_MODEL=deepseek-chat

# --- Legacy single endpoint: provider "default" becomes DeepSeek ---
# CORE_LLM_BASE_URL=https://api.deepseek.com/v1
# CORE_LLM_API_KEY=sk-REPLACE_ME
# CORE_LLM_MODEL=deepseek-chat

CORE_LOG_LEVEL=info
